<view class="container" style="padding-top:20rpx;">
  <view class="card">
    <view class="form-group">
      <text style="font-size:26rpx;color:var(--color-stone);margin-bottom:8rpx;display:block;">类型</text>
      <picker
        mode="selector"
        range="{{categories}}"
        value="{{categoryIndex}}"
        bindchange="onCategoryChange"
      >
        <view class="form-picker">
          <text>{{categories[categoryIndex]}}</text>
          <text style="color:#aaa;font-size:24rpx;">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text style="font-size:26rpx;color:var(--color-stone);margin-bottom:8rpx;display:block;">主题（可选）</text>
      <picker
        mode="selector"
        range="{{themeList}}"
        value="{{themeIndex}}"
        bindchange="onThemeChange"
      >
        <view class="form-picker">
          <text class="{{theme ? '' : 'placeholder-color'}}">{{theme || '选择主题（可选）'}}</text>
          <text style="color:#aaa;font-size:24rpx;">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text style="font-size:26rpx;color:var(--color-stone);margin-bottom:8rpx;display:block;">内容</text>
      <textarea
        class="form-textarea"
        placeholder="{{category === 'story' ? '写下你的故事...' : '写下你的短句...'}}"
        value="{{content}}"
        bindinput="onContentInput"
        maxlength="500"
        auto-height
        style="min-height:240rpx;"
      />
      <text style="font-size:22rpx;color:var(--color-stone);text-align:right;display:block;margin-top:8rpx;">{{content.length}}/500</text>
    </view>

    <button
      class="btn btn-primary btn-block"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >{{submitting ? '发布中...' : '发布'}}</button>
  </view>
</view>
